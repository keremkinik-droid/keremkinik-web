---
import Layout from '../../layouts/Layout.astro';
import site from '../../data/site.json';
import data from '../../data/yayinlar.json';
const yayinlar = [...data.yayinlar].sort((a, b) => b.yil - a.yil);
---
<Layout lang="en" path="/en/publications/" title="Publications">
  <div class="page-head">
    <div class="wrap">
      <p class="crumbs">Home / Publications</p>
      <h1>Scientific Publications</h1>
      <p>Peer-reviewed work in disaster medicine, public health, humanitarian diplomacy and transfusion medicine.</p>
    </div>
  </div>

  <section class="metrics">
    <div class="wrap">
      <div><div class="num">{site.metrikler.yayin}</div><div class="lbl">Total Works (ORCID)</div></div>
      <div><div class="num">{site.metrikler.atif}</div><div class="lbl">Citations (Google Scholar)</div></div>
      <div><div class="num">{site.metrikler.h_endeks}</div><div class="lbl">H-Index (Scholar)</div></div>
      <div><div class="num">{site.metrikler.atif_wos}</div><div class="lbl">Citations (WoS)</div></div>
      <div><div class="num">{site.metrikler.h_endeks_wos}</div><div class="lbl">H-Index (WoS)</div></div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="sec-sub" style="margin-top:0;">
        For the complete and up-to-date record:
        <a href={site.sosyal.scholar} target="_blank" rel="noopener"><strong>Google Scholar</strong></a> ·
        <a href={site.sosyal.orcid} target="_blank" rel="noopener"><strong>ORCID</strong></a> ·
        <a href={site.sosyal.wos} target="_blank" rel="noopener"><strong>Web of Science</strong></a> ·
        <a href={site.sosyal.scopus} target="_blank" rel="noopener"><strong>Scopus</strong></a>
      </p>
      <div class="pub-list">
        {yayinlar.map((y) => (
          <div class="pub">
            <div class="year">{y.yil}</div>
            <div>
              <h3>{y.baslik}</h3>
              <p class="journal">{y.dergi}</p>
              <p class="authors">{y.yazarlar}</p>
            </div>
            {y.doi && <a class="doi" href={`https://doi.org/${y.doi}`} target="_blank" rel="noopener">DOI ↗</a>}
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
